{
  "manifest_version": 3,
  "name": "DSH Browser Client",
  "version": "0.1.0",
  "description": "DeepSeek Harness 浏览器浮窗客户端：在每个页面右下角浮窗中运行 DSH 会话，当前页面资源目录即会话工作区。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js", "content/page-tools.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DSH Browser Client",
    "default_popup": "panel/panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["panel/panel.html", "panel/panel.js", "panel/panel.css", "common/dsh-client.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
